    "onboarding.features.desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The default setup keeps trackpad natural scrolling unchanged, reverses physical mouse wheel direction, supports smooth scrolling, and maps side buttons to shortcuts."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认保持触控板自然滚动不变，反转物理鼠标滚轮方向，并支持平滑滚动和侧键快捷键映射。"
          }
        }
      }
    },
