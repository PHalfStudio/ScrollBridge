    "onboarding.permissions.desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Input Monitoring identifies mouse events. Accessibility filters and sends only configured events. Auto launch stays off unless you enable it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入监控用于识别鼠标事件，辅助功能用于过滤并发送已配置的事件。开机自启默认关闭，只有主动开启后生效。"
          }
        }
      }
    },
    "onboarding.permissions.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permissions are required"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要系统权限"
          }
        }
      }
    },
    "onboarding.ready.desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After entering settings, enabled features apply immediately when permissions are authorized. You can turn everything off at any time."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "进入设置后，已开启的功能会在权限满足时立即生效。所有功能都可以随时关闭。"
          }
        }
      }
    },
